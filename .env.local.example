# ─────────────────────────────────────────────────────────────────
# WealthTrack — Environment Variables
# ─────────────────────────────────────────────────────────────────
#
# HOW TO USE:
# 1. Copy this file and rename it to: .env.local
# 2. Fill in your actual values below
# 3. NEVER commit .env.local to GitHub (it's already in .gitignore)
# 4. In Vercel: go to Settings → Environment Variables and add these
#
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────
# Get this from Neon (free): https://neon.tech
# Or from Supabase (free):   https://supabase.com
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://your_user:your_password@your_host/your_database?sslmode=require"

# ── NEXTAUTH ─────────────────────────────────────────────────────
# NEXTAUTH_URL: Your app's full URL
#   - Local development: http://localhost:3000
#   - Production (Vercel): https://your-app-name.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: A random secret string for signing tokens.
# Generate one by running this command in your terminal:
#   openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-random-secret-string-here-at-least-32-characters"

# ── NODE ENVIRONMENT ─────────────────────────────────────────────
# Leave this as "development" locally. Vercel sets it to "production" automatically.
NODE_ENV="development"
